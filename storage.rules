rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() { return request.auth != null; }
    function isRole(r) { return isAuth() && request.auth.token.role == r; }
    function isVendor() { return isRole('vendor'); }
    function isDriver() { return isRole('driver'); }
    function isCustomer() { return isRole('customer'); }
    function isAdmin() { return isRole('admin'); }
    function validImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024;
    }
    function validDoc() {
      return (request.resource.contentType.matches('image/.*')
           || request.resource.contentType == 'application/pdf')
          && request.resource.size < 20 * 1024 * 1024;
    }

    match /products/{vendorId}/{productId}/{file} {
      allow read:  if isAuth();
      allow write: if isVendor() && request.auth.uid == vendorId && validImage();
    }
    match /stores/{vendorId}/{file} {
      allow read:  if isAuth();
      allow write: if isVendor() && request.auth.uid == vendorId && validImage();
    }
    match /kyc/vendors/{vendorId}/{file} {
      allow read:  if request.auth.uid == vendorId || isAdmin();
      allow write: if request.auth.uid == vendorId && validDoc();
    }
    match /kyc/drivers/{driverId}/{file} {
      allow read:  if request.auth.uid == driverId || isAdmin();
      allow write: if request.auth.uid == driverId && validDoc();
    }
    match /avatars/customers/{customerId}/{file} {
      allow read:  if isAuth();
      allow write: if isCustomer() && request.auth.uid == customerId && validImage();
    }
    match /deliveries/{deliveryId}/{file} {
      allow read:  if isAuth();
      allow write: if isDriver() && validImage();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
